// DigitalHub — Database Schema
// All monetary values stored as integers in paisa (smallest BDT unit)
// ৳1,200 = 120000 paisa

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// ==================== AUTH & USERS ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  phone         String?
  password      String    // bcrypt hashed
  role          String    @default("CUSTOMER") // CUSTOMER, ADMIN, STAFF
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders            Order[]
  paymentReviews    PaymentSubmission[] @relation("ReviewedBy")
  auditLogs         AuditLog[]
  staffPermissions  StaffPermission[]

  @@index([email])
  @@index([role])
}

model StaffPermission {
  id         String @id @default(cuid())
  userId     String
  permission String // e.g., "manage_orders", "manage_products", "manage_users"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
}

// ==================== CATEGORIES ====================

model Category {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String?
  image        String?
  icon         String?
  parentId     String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  products Product[]
  categoryAttributes CategoryAttribute[]

  @@index([slug])
  @@index([parentId])
}

// ==================== PRODUCTS ====================

model Product {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  shortDesc      String?
  fullDesc       String?
  categoryId     String?
  productType    String   @default("DIGITAL_PRODUCT") // DIGITAL_SUBSCRIPTION, DIGITAL_DOWNLOAD, DIGITAL_SERVICE, ONLINE_COURSE, LICENSE_SOFTWARE, DIGITAL_PRODUCT
  featuredImage  String?
  isFeatured     Boolean  @default(false)
  isPublished    Boolean  @default(false)
  badge          String?  // New, Popular, Best Seller, Trending
  seoTitle       String?
  seoDesc        String?
  // Base price (used when no variations exist)
  regularPrice   Int      @default(0) // in paisa
  salePrice      Int?     // in paisa
  // Stock for simple products (no variations)
  stockQty       Int?
  lowStockThreshold Int   @default(5)
  stockStatus    String   @default("IN_STOCK") // IN_STOCK, LOW_STOCK, OUT_OF_STOCK, UNLIMITED
  trackStock     Boolean  @default(true)
  totalSold      Int      @default(0)
  isDeleted      Boolean  @default(false)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variations  ProductVariation[]
  orderItems  OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([isPublished, isDeleted])
  @@index([productType])
  @@index([isFeatured])
}

model ProductImage {
  id           String @id @default(cuid())
  productId    String
  url          String
  alt          String?
  displayOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ==================== ATTRIBUTES & VARIATIONS ====================

model ProductAttribute {
  id          String @id @default(cuid())
  name        String // e.g., "Plan", "Duration", "License Type"
  slug        String @unique
  createdAt   DateTime @default(now())

  options            AttributeOption[]
  categoryAttributes CategoryAttribute[]
  variationOptions   VariationOption[]

  @@index([slug])
}

model AttributeOption {
  id           String @id @default(cuid())
  attributeId  String
  value        String // e.g., "Basic", "1 Month", "Personal"
  displayOrder Int    @default(0)

  attribute        ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variationOptions VariationOption[]

  @@index([attributeId])
}

model CategoryAttribute {
  id          String @id @default(cuid())
  categoryId  String
  attributeId String

  category  Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
}

model ProductVariation {
  id                   String  @id @default(cuid())
  productId            String
  sku                  String?
  regularPrice         Int     // in paisa
  salePrice            Int?    // in paisa
  image                String?
  stockQty             Int?
  lowStockThreshold    Int     @default(5)
  stockStatus          String  @default("IN_STOCK") // IN_STOCK, LOW_STOCK, OUT_OF_STOCK, UNLIMITED
  isActive             Boolean @default(true)
  deliveryInstructions String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  variationOptions VariationOption[]
  orderItems       OrderItem[]

  @@index([productId])
  @@index([sku])
}

model VariationOption {
  id          String @id @default(cuid())
  variationId String
  attributeId String
  optionId    String

  variation ProductVariation  @relation(fields: [variationId], references: [id], onDelete: Cascade)
  attribute ProductAttribute  @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  option    AttributeOption   @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([variationId, attributeId])
  @@index([variationId])
}

// ==================== ORDERS ====================

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  userId      String?
  // Guest checkout fields
  guestEmail  String?
  guestName   String?
  guestPhone  String?
  // Order details
  status      String   @default("PENDING") // PENDING, AWAITING_PAYMENT, PAYMENT_UNDER_REVIEW, PAID, PROCESSING, COMPLETED, CANCELLED, REFUNDED, FAILED
  subtotal    Int      @default(0) // in paisa
  discount    Int      @default(0) // in paisa
  total       Int      @default(0) // in paisa
  currency    String   @default("BDT")
  notes       String?
  // Billing
  billingName    String?
  billingEmail   String?
  billingPhone   String?
  billingAddress String?
  // Metadata
  paymentMethod  String? // bkash, nagad, rocket, cod
  ipAddress      String?
  userAgent      String?
  isFlagged      Boolean  @default(false)
  flagReason     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  paymentSubmissions PaymentSubmission[]
  orderNotes         OrderNote[]
  activityLog        OrderActivity[]

  @@index([orderNumber])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String
  productId     String?
  variationId   String?
  // Snapshot at time of purchase (preserved even if product changes)
  productName   String
  variationDesc String? // e.g., "Plan: Pro, Duration: 1 Year"
  productImage  String?
  quantity      Int    @default(1)
  unitPrice     Int    // in paisa (price per unit at purchase time)
  totalPrice    Int    // in paisa (unitPrice * quantity)
  // Fulfillment
  deliveryStatus String @default("PENDING") // PENDING, PROCESSING, DELIVERED
  deliveryNotes  String?

  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variation ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  note      String
  isInternal Boolean @default(true) // Internal admin note vs customer-visible
  authorId  String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderActivity {
  id        String   @id @default(cuid())
  orderId   String
  action    String   // e.g., "status_changed", "payment_verified", "note_added"
  details   String?  // JSON string with additional details
  userId    String?  // Who performed the action
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

// ==================== PAYMENTS ====================

model PaymentSubmission {
  id            String   @id @default(cuid())
  orderId       String
  method        String   // bkash, nagad, rocket
  transactionId String?
  senderNumber  String?
  amount        Int      // in paisa
  status        String   @default("PENDING") // PENDING, VERIFIED, REJECTED
  submittedAt   DateTime @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewNotes   String?

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([method])
}

model PaymentMethodSetting {
  id                String  @id @default(cuid())
  name              String  // bkash, nagad, rocket, cod
  slug              String  @unique
  displayName       String  // "bKash", "Nagad", "Rocket", "Cash on Delivery"
  merchantNumber    String? // Receiving number
  accountType       String? // Personal/Merchant
  instructions      String? // Payment instructions
  qrCodeUrl         String?
  isActive          Boolean @default(true)
  supportedTypes    String? // JSON: which order types this supports
  verificationNotes String? // What info to collect from customer
  displayOrder      Int     @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([slug])
}

// ==================== SITE SETTINGS ====================

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String // Store as JSON string for complex values
  type  String @default("string") // string, number, boolean, json, image

  @@index([key])
}

model HeroSlide {
  id           String  @id @default(cuid())
  headline     String
  description  String?
  bgImage      String?
  ctaText      String?
  ctaUrl       String?
  badge        String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Page {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  content     String?
  isPublished Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

// ==================== AUDIT & SECURITY ====================

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // e.g., "payment_settings_updated", "product_created"
  entityType String?  // e.g., "Product", "Order", "PaymentMethodSetting"
  entityId   String?
  details    String?  // JSON
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RateLimit {
  id         String   @id @default(cuid())
  identifier String   // IP or userId
  action     String   // e.g., "order_submit", "payment_submit", "login"
  count      Int      @default(1)
  windowStart DateTime @default(now())
  expiresAt  DateTime

  @@unique([identifier, action])
  @@index([expiresAt])
}
